# SmartCivic Environment Configuration

# Flask app setting
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security secrets
SECRET_KEY=change-this-to-a-very-secure-random-string
JWT_SECRET_KEY=change-this-to-another-secure-random-string

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/smartcivic
